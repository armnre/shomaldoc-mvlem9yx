{
  "name": "shomaldoc-server",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "tsx --tsconfig tsconfig.json src/index.ts",
    "dev": "tsx watch --tsconfig tsconfig.json src/index.ts",
    "migrate": "tsx --tsconfig tsconfig.json scripts/migrate.ts",
    "build:web": "cd ../apps/app && ../../node_modules/.bin/vite build --config ../../server/web/vite.config.ts",
    "schema": "python3 scripts/gen-schema.py",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:e2e": "tsx --tsconfig tsconfig.json e2e/reset-db.ts && playwright test",
    "job": "tsx --tsconfig tsconfig.json src/index.ts run-job"
  },
  "dependencies": {
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.1",
    "multer": "^2.5.0",
    "node-cron": "^4.6.0",
    "nodemailer": "^10.2.1",
    "pg": "^8.13.1",
    "puppeteer-core": "^23.10.0",
    "tsx": "^4.19.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.12",
    "@types/node": "^26.6.5",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.11.10",
    "@types/smtp-server": "^3.5.13",
    "smtp-server": "^3.21.1",
    "typescript": "5.7",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": "^20.0.0 || ^22.0.0"
  }
}
