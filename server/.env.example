# ---- PostgreSQL (local, native install) ----
DATABASE_URL=postgres://shomal:CHANGE_ME@127.0.0.1:5432/shomaldoc
PG_POOL=10

# ---- HTTP ----
HOST=127.0.0.1
PORT=3080
PUBLIC_URL=https://shomaldoc.shomal.ac.ir
# Number of reverse proxies in front of Node (Plesk nginx = 1)
TRUST_PROXY_HOPS=1
# Send HSTS even if the proxy does not forward X-Forwarded-Proto
FORCE_HSTS=true

# ---- Files ----
UPLOAD_DIR=/var/lib/shomaldoc/uploads
MAX_UPLOAD_MB=20

# ---- PDF rendering: real Google Chrome (see README) ----
CHROMIUM_PATH=/usr/bin/google-chrome-stable

# ---- Security ----
PBKDF2_ITERATIONS=600000
RATE_LOGIN=10
RATE_UPLOAD=60

# ---- Email (SMTP via nodemailer). Leave SMTP_HOST empty to only log emails. ----
SMTP_HOST=mail.shomal.ac.ir
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=noreply@shomal.ac.ir
SMTP_PASS=CHANGE_ME
SMTP_FROM="شمال‌داک <noreply@shomal.ac.ir>"

# ---- SMS (Kavenegar). Leave KAVENEGAR_API_KEY empty to only log SMS. ----
SMS_PROVIDER=kavenegar
KAVENEGAR_API_KEY=
KAVENEGAR_SENDER=

# ---- Internal scheduler (node-cron, Asia/Tehran) ----
CRON_REMINDERS=0 7 * * *
CRON_TERM=30 3 * * *
DISABLE_JOBS=false

# ---- Backups (deploy/backup.sh) ----
BACKUP_DIR=/var/backups/shomaldoc
BACKUP_KEEP_DAYS=14
