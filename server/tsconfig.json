{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "strict": true,
    "strictNullChecks": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "zitejs/db": [
        "../.zite/db.ts"
      ],
      "zitejs/runtime": [
        "./src/shims/runtime.ts"
      ],
      "zitejs/backend": [
        "./src/shims/backend.ts"
      ],
      "zitejs/pdf": [
        "./src/shims/pdf.ts"
      ],
      "zod": [
        "../node_modules/zod"
      ]
    },
    "types": [
      "node"
    ]
  },
  "include": [
    "src",
    "scripts",
    "test",
    "../apps/app/src/api",
    "../apps/app/src/lib/server.ts",
    "../apps/app/src/lib/jalali.ts",
    "../apps/app/src/lib/logoData.ts"
  ]
}